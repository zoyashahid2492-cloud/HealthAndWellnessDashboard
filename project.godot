; Engine configuration file.
; Project Afterlight prototype built for Godot 4.x.

config_version=5

[application]

config/name="Project Afterlight"
run/main_scene="res://scenes/main/Game.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/systems/game_state.gd"
SaveSystem="*res://scripts/systems/save_system.gd"
